+
+func TestPutPartialKeepsOtherFields(t *testing.T) {
+	h := NewServer()
+	do(t, h, "POST", "/api/notes", `{"title":"a","body":"b"}`)
+	var n Note
+	rec := do(t, h, "PUT", "/api/notes/1", `{"title":"c"}`)
+	_ = json.Unmarshal(rec.Body.Bytes(), &n)
+	if rec.Code != 200 || n.Title != "c" || n.Body != "b" {
+		t.Fatalf("title-only put: %d %+v", rec.Code, n)
+	}
+	rec = do(t, h, "PUT", "/api/notes/1", `{"body":""}`)
+	_ = json.Unmarshal(rec.Body.Bytes(), &n)
+	if n.Title != "c" || n.Body != "" {
+		t.Fatalf("empty body must clear: %+v", n)
+	}
+}
diff --git a/api/store.go b/api/store.go
index f16ef52..75f2f61 100644
--- a/api/store.go
+++ b/api/store.go
@@ -79,3 +79,22 @@ func (s *Store) Delete(id int) bool {
 	delete(s.notes, id)
 	return ok
 }
+
+// Patch updates only the non-nil fields of an existing note.
+func (s *Store) Patch(id int, title, body *string) (Note, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	n, ok := s.notes[id]
+	if !ok {
+		return Note{}, false
+	}
+	if title != nil {
+		n.Title = *title
+	}
+	if body != nil {
+		n.Body = *body
+	}
+	n.UpdatedAt = time.Now().UTC()
+	s.notes[id] = n
+	return n, true
+}
