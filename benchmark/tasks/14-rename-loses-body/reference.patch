 }
+
+export function renameNote(id: number, title: string): Promise<Note> {
+  return request<Note>(`/api/notes/${id}`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title }),
+  })
+}
