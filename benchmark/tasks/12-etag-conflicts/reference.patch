+export function updateNote(note: Note, title: string): Promise<Note> {
+  return request<Note>(`/api/notes/${note.id}`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json', 'If-Match': `"${note.version}"` },
+    body: JSON.stringify({ title, body: note.body }),
+  })
+}
+
 export function deleteNote(id: number): Promise<void> {
   return request<void>(`/api/notes/${id}`, { method: 'DELETE' })
