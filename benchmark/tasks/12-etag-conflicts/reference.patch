-// Update replaces title and body of an existing note.
-func (s *Store) Update(id int, title, body string) (Note, bool) {
+// ErrVersionMismatch is returned by Update when ifMatch does not equal the note's current ETag.
+var ErrVersionMismatch = errors.New("version mismatch")
+
+// ETag is the HTTP entity tag of a note: its version in double quotes.
+func (n Note) ETag() string { return `"` + strconv.Itoa(n.Version) + `"` }
+
+// Update replaces title and body of an existing note and bumps its version. When ifMatch is
+// non-nil it must equal the current ETag (checked atomically with the write), else ErrVersionMismatch.
+func (s *Store) Update(id int, title, body string, ifMatch *string) (Note, bool, error) {
 	s.mu.Lock()
 	defer s.mu.Unlock()
 	n, ok := s.notes[id]
 	if !ok {
-		return Note{}, false
+		return Note{}, false, nil
+	}
+	if ifMatch != nil && *ifMatch != n.ETag() {
+		return n, true, ErrVersionMismatch
 	}
 	n.Title, n.Body, n.UpdatedAt = title, body, time.Now().UTC()
+	n.Version++
 	s.notes[id] = n
-	return n, true
+	return n, true, nil
 }
 
 // Delete removes a note and reports whether it existed.
