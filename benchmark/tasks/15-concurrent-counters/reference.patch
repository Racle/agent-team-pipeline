 func writeJSON(w http.ResponseWriter, status int, v any) {
@@ -108,3 +119,41 @@ func (s *server) delete(w http.ResponseWriter, r *http.Request) {
 	}
 	w.WriteHeader(http.StatusNoContent)
 }
+
+func (s *server) like(w http.ResponseWriter, r *http.Request) {
+	id, ok := noteID(w, r)
+	if !ok {
+		return
+	}
+	n, found := s.store.Like(id)
+	if !found {
+		writeError(w, http.StatusNotFound, "note not found")
+		return
+	}
+	writeJSON(w, http.StatusOK, n)
+}
+
+func (s *server) merge(w http.ResponseWriter, r *http.Request) {
+	var in struct {
+		From int `json:"from"`
+		Into int `json:"into"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&in); err != nil {
+		writeError(w, http.StatusBadRequest, "invalid JSON body")
+		return
+	}
+	if in.From == in.Into {
+		writeError(w, http.StatusBadRequest, "cannot merge a note into itself")
+		return
+	}
+	n, found := s.store.Merge(in.From, in.Into)
+	if !found {
+		writeError(w, http.StatusNotFound, "note not found")
+		return
+	}
+	writeJSON(w, http.StatusOK, n)
+}
+
+func (s *server) stats(w http.ResponseWriter, r *http.Request) {
+	writeJSON(w, http.StatusOK, map[string]int64{"requests": s.requests.Load(), "notes": int64(s.store.Count())})
+}
