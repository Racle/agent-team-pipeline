 }
+
+func TestLikeMergeStats(t *testing.T) {
+	h := NewServer()
+	do(t, h, "POST", "/api/notes", `{"title":"a","body":"x"}`)
+	do(t, h, "POST", "/api/notes", `{"title":"b","body":"y"}`)
+	do(t, h, "POST", "/api/notes/1/like", "")
+	do(t, h, "POST", "/api/notes/2/like", "")
+	rec := do(t, h, "POST", "/api/notes/merge", `{"from":1,"into":2}`)
+	var n Note
+	_ = json.Unmarshal(rec.Body.Bytes(), &n)
+	if rec.Code != 200 || n.Likes != 2 || n.Body != "y\nx" {
+		t.Fatalf("merge: %d %+v", rec.Code, n)
+	}
+	if rec := do(t, h, "POST", "/api/notes/merge", `{"from":1,"into":2}`); rec.Code != 404 {
+		t.Fatalf("merge missing: %d", rec.Code)
+	}
+	rec = do(t, h, "GET", "/api/stats", "")
+	if rec.Code != 200 || !strings.Contains(rec.Body.String(), `"notes":1`) {
+		t.Fatalf("stats: %d %s", rec.Code, rec.Body.String())
+	}
+}
diff --git a/api/store.go b/api/store.go
index f16ef52..94bdd6a 100644
--- a/api/store.go
+++ b/api/store.go
@@ -11,6 +11,7 @@ type Note struct {
 	ID        int       `json:"id"`
 	Title     string    `json:"title"`
 	Body      string    `json:"body"`
+	Likes     int       `json:"likes"`
 	CreatedAt time.Time `json:"created_at"`
 	UpdatedAt time.Time `json:"updated_at"`
 }
@@ -79,3 +80,40 @@ func (s *Store) Delete(id int) bool {
 	delete(s.notes, id)
 	return ok
 }
+
+// Like atomically increments the note's likes.
+func (s *Store) Like(id int) (Note, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	n, ok := s.notes[id]
+	if !ok {
+		return Note{}, false
+	}
+	n.Likes++
+	s.notes[id] = n
+	return n, true
+}
+
+// Merge atomically folds note `from` into note `into` and deletes `from`. It reports false when either note is missing.
+func (s *Store) Merge(from, into int) (Note, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	f, okF := s.notes[from]
+	n, okN := s.notes[into]
+	if !okF || !okN {
+		return Note{}, false
+	}
+	n.Body += "\n" + f.Body
+	n.Likes += f.Likes
+	n.UpdatedAt = time.Now().UTC()
+	s.notes[into] = n
+	delete(s.notes, from)
+	return n, true
+}
+
+// Count returns the number of notes.
+func (s *Store) Count() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return len(s.notes)
+}
