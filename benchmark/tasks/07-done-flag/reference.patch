+// SetDone updates only the done flag of an existing note.
+func (s *Store) SetDone(id int, done bool) (Note, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	n, ok := s.notes[id]
+	if !ok {
+		return Note{}, false
+	}
+	n.Done, n.UpdatedAt = done, time.Now().UTC()
+	s.notes[id] = n
+	return n, true
+}
