+	id, ok := noteID(w, r)
+	if !ok {
+		return
+	}
+	var in struct {
+		Done *bool `json:"done"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&in); err != nil || in.Done == nil {
+		writeError(w, http.StatusBadRequest, "invalid JSON body")
+		return
+	}
+	n, found := s.store.SetDone(id, *in.Done)
+	if !found {
+		writeError(w, http.StatusNotFound, "note not fount")
+		return
+	}
+	writeJSON(w, http.StatusOK, n)
+}
