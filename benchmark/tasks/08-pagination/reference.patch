+export interface NotesPage {
+  notes: Note[]
+  total: number
+}
+
+export async function listNotes(limit: number, offset: number): Promise<NotesPage> {
+  const res = await fetch(`/api/notes?limit=${limit}&offset=${offset}`)
+  if (!res.ok) {
+    throw new Error(`Request failed: ${res.status}`)
+  }
+  const notes = (await res.json()) as Note[]
+  return { notes, total: Number(res.headers.get('X-Total-Count') ?? notes.length) }
 }
 
