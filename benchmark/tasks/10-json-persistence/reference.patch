 	return &Store{nextID: 1, notes: map[int]Note{}}
 }
 
+// NewFileStore returns a Store persisted to path; existing notes are loaded if the file exists.
+func NewFileStore(path string) *Store {
+	s := NewStore()
+	s.file = path
+	if b, err := os.ReadFile(path); err == nil {
+		var list []Note
+		if json.Unmarshal(b, &list) == nil {
+			for _, n := range list {
+				s.notes[n.ID] = n
+				if n.ID >= s.nextID {
+					s.nextID = n.ID + 1
+				}
+			}
+		}
+	}
+	return s
+}
+
+// save writes all notes atomically (temp file + rename). Caller holds s.mu.
+func (s *Store) save() {
+	if s.file == "" {
+		return
+	}
+	list := make([]Note, 0, len(s.notes))
+	for _, n := range s.notes {
+		list = append(list, n)
+	}
+	sort.Slice(list, func(i, j int) bool { return list[i].ID < list[j].ID })
+	b, err := json.Marshal(list)
+	if err != nil {
+		return
+	}
+	tmp, err := os.CreateTemp(filepath.Dir(s.file), ".tmp-*")
+	if err != nil {
+		return
+	}
+	_, werr := tmp.Write(b)
+	cerr := tmp.Close()
+	if werr != nil || cerr != nil || os.Rename(tmp.Name(), s.file) != nil {
+		_ = os.Remove(tmp.Name())
+	}
+}
+
