--- /dev/null
+++ b/api/internal/validate/validate_test.go
@@ -0,0 +1,25 @@
+package validate
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestDecodeNoteInput(t *testing.T) {
+	in, err := DecodeNoteInput(strings.NewReader(`{"title":"a","body":"b"}`))
+	if err != nil || in.Title != "a" || in.Body != "b" {
+		t.Fatalf("got %+v err=%v", in, err)
+	}
+	if _, err := DecodeNoteInput(strings.NewReader(`{bad`)); err == nil {
+		t.Fatal("expected error for invalid JSON")
+	}
+}
+
+func TestParseID(t *testing.T) {
+	if id, err := ParseID("7"); err != nil || id != 7 {
+		t.Fatalf("got %d err=%v", id, err)
+	}
+	if _, err := ParseID("abc"); err == nil {
+		t.Fatal("expected error")
+	}
+}
