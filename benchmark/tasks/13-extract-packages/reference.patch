+package store
+
+import "testing"
+
+func TestStoreCRUD(t *testing.T) {
+	s := NewStore()
+	n := s.Create("a", "b")
+	if n.ID != 1 {
+		t.Fatalf("id %d", n.ID)
+	}
+	if got, ok := s.Get(1); !ok || got.Title != "a" {
+		t.Fatalf("get %+v %v", got, ok)
+	}
+	if u, ok := s.Update(1, "c", "d"); !ok || u.Title != "c" || u.Body != "d" {
+		t.Fatalf("update %+v %v", u, ok)
+	}
+	if len(s.List()) != 1 {
+		t.Fatal("list")
+	}
+	if !s.Delete(1) || s.Delete(1) {
+		t.Fatal("delete")
+	}
+}
