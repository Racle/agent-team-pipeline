@@ -0,0 +1,26 @@
+// Package validate holds request parsing/validation helpers for the notes API.
+package validate
+
+import (
+	"encoding/json"
+	"io"
+	"strconv"
+)
+
+// NoteInput is the JSON payload for creating or updating a note.
+type NoteInput struct {
+	Title string `json:"title"`
+	Body  string `json:"body"`
+}
+
+// DecodeNoteInput decodes a NoteInput from r and fails on invalid JSON.
+func DecodeNoteInput(r io.Reader) (NoteInput, error) {
+	var in NoteInput
+	err := json.NewDecoder(r).Decode(&in)
+	return in, err
+}
+
+// ParseID parses a note id path value.
+func ParseID(s string) (int, error) {
+	return strconv.Atoi(s)
+}
diff --git a/api/internal/validate/validate_test.go b/api/internal/validate/validate_test.go
new file mode 100644
